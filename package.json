{
  "name": "relay-orchestrator",
  "version": "0.1.0",
  "description": "Local multi-agent software-engineering orchestrator. Coordinates already-installed coding CLIs (Claude Code, Codex) to plan, review, implement and critique work on a GitHub issue inside an isolated git worktree.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aydinmrnv/relay.git"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "bin": {
    "relay": "./bin/relay.mjs"
  },
  "man": ["./man/relay.1"],
  "files": [
    "bin",
    "dist",
    "eval",
    "README.md",
    "man"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "test:watch": "node --test --watch --experimental-strip-types \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "generate:man": "node scripts/generate-man.mjs",
    "prepack": "npm run build && npm run generate:man && npm pack --dry-run --ignore-scripts"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
