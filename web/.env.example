# Copy to .env.local for development, or set these on your host (Vercel →
# Project → Settings → Environment Variables). Nothing here is required for
# `npm run dev`: without DATABASE_URL the studio uses an embedded Postgres in
# .data/pglite, and in development a fixed session secret.

# --- Accounts (required in production) ---------------------------------------

# Any Postgres. On Vercel: Storage → Create → Neon, which sets this for you.
DATABASE_URL=

# 32+ random characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public URL, e.g. https://relay.example.com. Optional on Vercel, where
# the production domain is known; set it if you use a custom domain.
BETTER_AUTH_URL=

# Extra hostnames allowed to serve sign-in, comma separated (custom domains).
# Vercel's production, preview and branch URLs are allowed automatically.
AUTH_ALLOWED_HOSTS=

# --- Sign in with GitHub (optional) ------------------------------------------

# github.com/settings/developers → New OAuth App.
# Callback URL: <your URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email: password resets and confirmations (optional) ---------------------

# resend.com → API Keys. Without it, production has no password reset (GitHub
# sign-in still works) and development prints the links to the server log.
RESEND_API_KEY=
# A sender on a domain you verified with Resend.
EMAIL_FROM="Relay <hello@example.com>"

# --- Branding (optional) -----------------------------------------------------

NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_PRODUCT_TAGLINE=
