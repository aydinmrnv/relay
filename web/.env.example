# Copy to .env.local for development, or set these on your host (Vercel →
# Project → Settings → Environment Variables). `npm run dev` needs nothing
# here: without DATABASE_URL the studio uses an embedded Postgres in
# .data/pglite, and without Clerk keys it serves the browser-only studio with
# accounts switched off. `npx clerk env pull` writes the two Clerk keys below
# into .env.local, and then accounts work in development too.
#
# In production the first four sections are required: /api/health answers 503
# until the database, both Clerk keys, the credentials key and the deletion
# webhook secret are all set.

# --- Accounts (required in production) ----------------------------------------

# Clerk: dashboard.clerk.com → API keys, or `npx clerk env pull`. The sign-in
# and sign-up pages are /sign-in and /sign-up; nothing here configures them.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (required in production) ----------------------------------------

# A Postgres database of the studio's own, for workflows, runs, versions, share
# links and rate limits. Do not point it at a database another app uses: the
# studio creates and migrates its own `relay_` tables on first request.
# On Vercel: Storage → Create → Neon, which sets this for you. POSTGRES_URL is
# read when DATABASE_URL is not set.
DATABASE_URL=

# Connections each server instance may hold. Leave unset on serverless hosts
# (the default is small on purpose); raise it on one long-lived server.
# DATABASE_POOL_MAX=

# Development only: where the embedded Postgres keeps its files when
# DATABASE_URL is not set. Defaults to .data/pglite.
# PGLITE_DIR=

# --- App connections (required in production) ---------------------------------

# Encrypts the webhooks and API tokens people connect apps with, before they
# reach the database: 32 random bytes, base64 (`openssl rand -base64 32`). Development
# makes its own in .data/credentials.key. Without it in production, apps can
# only be marked ready.
RELAY_CREDENTIALS_KEY=

# To change the key: move the old one here and put the new one above. Stored
# connections are read with the old key and resealed with the new one as they
# are used; remove this once they have been.
# RELAY_CREDENTIALS_KEY_PREVIOUS=

# --- Account deletion from Clerk (required in production) ---------------------

# Clerk dashboard → Webhooks → Add endpoint <your URL>/api/webhooks/clerk,
# subscribed to `user.deleted`, then paste its signing secret here. Deleting an
# account from Settings works without it; this is what removes the data of an
# account deleted in Clerk's dashboard, so production refuses to report healthy
# without it.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Relay Cloud (optional) ---------------------------------------------------

# The hub scripts/azure/deploy-hub.sh prints, e.g. https://relay-hub.example.ts.net.
# Signed-in people can then ask for a cloud machine of their own. The browser
# calls it directly with its Clerk session; nothing here is secret. Leave it
# unset and the studio does not mention Relay Cloud as something you can use.
RELAY_CLOUD_HUB_URL=

# The name of a Clerk JWT template made for the hub (Clerk dashboard → JWT
# templates; a short lifetime and no extra claims is enough). With it the
# browser hands the hub a token of that template and not its session token, so
# what the hub sees is not what the studio's own API takes. The hub checks the
# `azp` claim Clerk puts in every token against its studio origins. Without
# this the browser sends its ordinary session token.
# RELAY_CLOUD_JWT_TEMPLATE=

# --- Links (optional) ---------------------------------------------------------

# The public URL, e.g. https://relay.example.com, for social cards, the
# sitemap and the list of origins a session may come from, when it is not
# Vercel's production domain.
NEXT_PUBLIC_SITE_URL=

# Set to 1 on a hosted build that is not on Vercel, so the studio says test
# runs are played back in the browser and points at the page for choosing a
# runner. Vercel builds have it on already.
# NEXT_PUBLIC_HOSTED_DEMO=

# Development only: extra hosts allowed to load the dev server's assets, comma
# separated, for opening `npm run dev` from a phone on your network.
# RELAY_DEV_ORIGINS=192.168.1.20
