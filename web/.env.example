# Copy to .env.local for development, or set these on your host (Vercel →
# Project → Settings → Environment Variables). `npm run dev` needs nothing
# here: without DATABASE_URL the studio uses an embedded Postgres in
# .data/pglite, and without Clerk keys it serves the browser-only studio with
# accounts switched off. `npx clerk env pull` writes the two Clerk keys below
# into .env.local, and then accounts work in development too.

# --- Accounts (required for accounts, anywhere) ------------------------------

# Clerk: dashboard.clerk.com → API keys, or `npx clerk env pull`.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where Clerk's own screens send people; the studio's pages live here.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Any Postgres, for workflows, runs, versions and share links.
# On Vercel: Storage → Create → Neon, which sets this for you.
DATABASE_URL=

# --- App connections (required for real ones in production) ------------------

# Encrypts the Slack and Discord webhooks people connect, before they reach the
# database: 32 random bytes, base64 (`openssl rand -base64 32`). Development
# makes its own in .data/credentials.key. Without it in production, apps can
# only be marked ready. Changing it makes stored connections unreadable.
RELAY_CREDENTIALS_KEY=

# --- Account deletion from Clerk (recommended) -------------------------------

# Clerk dashboard → Webhooks → Add endpoint <your URL>/api/webhooks/clerk,
# subscribed to `user.deleted`, then paste its signing secret here. Deleting an
# account from Settings works without it; this covers deletions made in Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Relay Cloud (optional) ----------------------------------------------------

# The hub scripts/azure/deploy-hub.sh prints, e.g. https://relay-hub.example.ts.net.
# Signed-in people can then run on a cloud machine of their own. The browser
# calls it directly with its Clerk session; nothing here is secret.
RELAY_CLOUD_HUB_URL=

# --- Links and branding (optional) -------------------------------------------

# The public URL, e.g. https://relay.example.com, for social cards and the
# sitemap when it is not Vercel's production domain.
NEXT_PUBLIC_SITE_URL=

NEXT_PUBLIC_PRODUCT_NAME=
NEXT_PUBLIC_PRODUCT_TAGLINE=
